# ─────────────────────────────────────────────────────────────
# Private AI LifeOS — environment template
# Copy to .env and fill in real values. NEVER commit a real .env.
# No secret in this file is real; all are placeholders.
# ─────────────────────────────────────────────────────────────

# ── App ──
APP_ENV=development
# Long random string used to sign cookies/CSRF. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=change-me-to-a-long-random-string
APP_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
# Dev convenience: auto-create DB tables on startup. Set false once you
# manage schema with Alembic migrations exclusively.
AUTO_CREATE_TABLES=true

# ── Single admin user (you) ──
# On first startup, if no user exists and ADMIN_PASSWORD is set, the app
# creates your account. The password is hashed at rest and never logged.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password
# If true, you must set up an authenticator app (TOTP) and enter a code at login.
ADMIN_TOTP_ENABLED=false

# ── Database ──
# docker-compose provides the 'db' host. Without Postgres, SQLite is fine for dev.
DATABASE_URL=postgresql+psycopg://lifeos:lifeos@db:5432/lifeos
# Example SQLite fallback (no server needed):
# DATABASE_URL=sqlite+pysqlite:///./lifeos.db

# ── Redis (sessions + rate limiting) ──
REDIS_URL=redis://redis:6379/0

# ── Session / security ──
SESSION_TTL_SECONDS=86400
SESSION_COOKIE_NAME=lifeos_session
# Set true when serving over HTTPS (required for passkeys later).
SESSION_COOKIE_SECURE=false
LOGIN_RATE_LIMIT_PER_MINUTE=5
