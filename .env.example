# ─────────────────────────────────────────────────────────────
# Private AI LifeOS — environment template
# Copy to .env and fill in real values. NEVER commit a real .env.
# No secret in this file is real; all are placeholders.
# ─────────────────────────────────────────────────────────────

# ── App ──
APP_ENV=development
# Long random string used to sign cookies/CSRF. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=change-me-to-a-long-random-string
APP_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
# Dev convenience: auto-create DB tables on startup. Set false once you
# manage schema with Alembic migrations exclusively.
AUTO_CREATE_TABLES=true

# ── Single admin user (you) ──
# On first startup, if no user exists and ADMIN_PASSWORD is set, the app
# creates your account. The password is hashed at rest and never logged.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password
# If true, you must set up an authenticator app (TOTP) and enter a code at login.
ADMIN_TOTP_ENABLED=false

# ── Database ──
# docker-compose provides the 'db' host. Without Postgres, SQLite is fine for dev.
DATABASE_URL=postgresql+psycopg://lifeos:lifeos@db:5432/lifeos
# Example SQLite fallback (no server needed):
# DATABASE_URL=sqlite+pysqlite:///./lifeos.db

# ── Redis (sessions + rate limiting) ──
REDIS_URL=redis://redis:6379/0

# ── Session / security ──
SESSION_TTL_SECONDS=86400
SESSION_COOKIE_NAME=lifeos_session
# Set true when serving over HTTPS (required for passkeys later).
SESSION_COOKIE_SECURE=false
LOGIN_RATE_LIMIT_PER_MINUTE=5

# ── Display ──
# Timezone for analytics windows and (later) daily briefings, e.g. Asia/Tashkent.
DISPLAY_TIMEZONE=UTC

# ── GitHub monitoring (read-only) ──
# A fine-grained Personal Access Token with READ-ONLY repo access.
# Create at: https://github.com/settings/personal-access-tokens
# Needed scopes (read): Contents, Metadata, Issues, Pull requests.
GITHUB_TOKEN=
GITHUB_API_BASE=https://api.github.com
# How often the background poller checks watched repos (seconds; min 30).
GITHUB_POLL_INTERVAL_SECONDS=120
# Optional: your own GitHub username, to mark "my" activity in analytics.
GITHUB_OWNER_LOGIN=
# Set false to disable the background poll loop (e.g. when running jobs yourself).
ENABLE_SCHEDULER=true

# ── Telegram bot (notifications + two-way chat; YOU only) ──
# Create a bot with @BotFather to get the token; message your bot once, then
# find your numeric chat id (e.g. via @userinfobot). Both must be set to enable.
# The bot responds ONLY to this chat id; everyone else is refused.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Claude AI (for the chat feature) — choose ONE ──
# Option A (recommended, fully supported): official Anthropic API key, pay-as-you-go.
#   Get one at https://console.anthropic.com  (small cost for personal use)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
#
# Option B (your Claude Pro/Max subscription via the Claude Agent SDK).
#   ⚠️ Anthropic's docs say products/agents should use an API key, not a
#   subscription login. For a private single-user tool it's a gray area — use at
#   your own discretion. Requires: pip install claude-agent-sdk, and either a
#   local `claude` login OR a token from `claude setup-token`.
USE_CLAUDE_SUBSCRIPTION=false
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_AGENT_MODEL=sonnet
# Reasoning effort: low | medium | high | xhigh | max.
# medium = fast + good, uses less of your Pro limit. high = deeper, slower, more usage.
CLAUDE_EFFORT=medium

# ── Weather (/weather + morning brief) ───────────────────────────────
# Open-Meteo — free, no API key. Defaults to Tashkent.
WEATHER_CITY=Toshkent
WEATHER_LATITUDE=41.3111
WEATHER_LONGITUDE=69.2797
# Daily morning briefing (weather + clothing tip) pushed to Telegram.
MORNING_BRIEF_ENABLED=true
MORNING_BRIEF_HOUR=8
MORNING_BRIEF_MINUTE=0

# ── Jira (read-only /jira) ───────────────────────────────────────────
# Shows issues assigned to you. Create a token at:
#   https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
